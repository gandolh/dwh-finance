# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Node environment: "development" | "production" (affects logging output)
NODE_ENV=development
# HTTP server port (default: 3000)
PORT=3000
# HTTP server host (default: 0.0.0.0)
HOST=0.0.0.0
# Log level: error | warn | info | debug (default: info)
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB connection string (default: mongodb://localhost:27017/dwh_finance)
MONGODB_URI=mongodb://localhost:27017/dwh_finance

# ---------------------------------------------------------------------------
# Market data provider API keys (ETL extractors)
# ---------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=
